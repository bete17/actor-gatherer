#!/bin/sh
# After a pull or a merge: the dashboard's page built again (frontend/ into ag_dashboard/static/) when the pull changed
# its source, or it has never been built here, so the dashboard serves what was pulled (ag_dashboard/DESIGN.md).
# Turned on once for a clone and its worktrees: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 0
if [ -f ag_dashboard/static/index.html ] && [ -z "$(git diff --name-only ORIG_HEAD HEAD -- frontend 2>/dev/null)" ]; then
  exit 0
fi
if ! command -v corepack >/dev/null 2>&1; then
  echo "post-merge: the dashboard's page needs Node 22 (with corepack) to build: see frontend/" >&2
  exit 0
fi
echo "post-merge: building the dashboard's page (frontend/)" >&2
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
(cd frontend && corepack pnpm install --frozen-lockfile --silent && corepack pnpm build --logLevel warn) ||
  echo "post-merge: the build failed; run: cd frontend && corepack pnpm install && corepack pnpm build" >&2
exit 0
